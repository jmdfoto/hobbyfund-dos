// Cloudflare Worker config: serves the built React app from ./dist and the API under /api/*.
// See docs/cloudflare-setup.md for first-time setup.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hobbyfund",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // Serve only on the custom domain, which Cloudflare Access protects. No *.workers.dev or
  // preview URLs, so there's no second address that skips the login screen.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "hobbyfund.app", "custom_domain": true }],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hobbyfund",
      "database_id": "a9727cc2-d897-4219-89a3-2ccf42ea5b81",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Your Zero Trust team domain, e.g. "hobbyfund.cloudflareaccess.com".
    "ACCESS_TEAM_DOMAIN": "hobbyfund.cloudflareaccess.com",
    // The "Application Audience (AUD) Tag" from the Access application's settings.
    "ACCESS_AUD": "ae521ff8cf1c5c93274a747a73ba0f7c14ef241d8a16adaf42a0bb97c3e5ef19"
  }
}
