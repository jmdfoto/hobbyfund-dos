# Copy to .env for local development (never committed, never deployed). Run the dev server with
# CLOUDFLARE_INCLUDE_PROCESS_ENV=true (npm run dev does) so the Alpaca keys saved in your Windows
# environment variables reach the local Worker without being written to any file.
# Never prefix anything here with VITE_ — Vite would put it in the browser bundle.

# Pretends you're signed in as this user; only honored for requests to localhost.
DEV_AUTH_EMAIL=parent@example.com
# Blanks the real Access audience from wrangler.jsonc so the pretend login above applies locally.
ACCESS_AUD=
